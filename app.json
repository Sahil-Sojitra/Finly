{
  "expo": {
    "name": "Finly",
    "slug": "finly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finly",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#2563EB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finly.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Finly requires microphone access to record voice transactions.",
        "NSSpeechRecognitionUsageDescription": "Finly uses speech recognition to parse natural language expense and income details.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#142A59",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.finly.app",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Finly needs access to your microphone to record voice expenses.",
          "speechRecognitionPermission": "Finly uses speech recognition to transcribe natural language expense and income commands."
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "groupIdentifier": "group.com.finly.app",
          "widgets": [
            {
              "name": "FinlyWidget",
              "displayName": "Finly Cycle & Balance",
              "description": "Track available balance and salary cycle progress on your home screen",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
