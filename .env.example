# Application Environment Configuration
# Copy this file to .env.local for local overrides
# DO NOT commit .env or secrets to version control

# Runtime environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Application branding
EXPO_PUBLIC_APP_NAME="MyChoice AI"

# Default localization & currency
EXPO_PUBLIC_DEFAULT_CURRENCY="INR"
EXPO_PUBLIC_DEFAULT_LOCALE="en-IN"

# Optional Cloud Backup Client IDs (for Phase 6 Google Drive integration)
# EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID_ANDROID=""
# EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID_IOS=""

